"fontSize": 13, "fontWeight": "normal"}, {"type": "frame", "id": "oKbmM", "name": "Peek Meta", "width": "fill_container", "gap": 6, "alignItems": "center", "children": [{"type": "frame", "id": "qJXfu", "name": "App lark", "width": 14, "height": 14, "fill": {"type": "gradient", "gradientType": "linear", "enabled": true, "rotation": 180, "size": {"height": 1}, "colors": [{"color": "#3C8CFF", "position": 0}, {"color": "#16C1B3", "position": 1}]}, "cornerRadius": 4, "stroke": "$hair", "strokeWidth": 1, "strokeAlignment": "inner", "justifyContent": "center", "alignItems": "center", "children": [{"type": "icon", "id": "PJOcG", "name": "Glyph", "width": 8, "height": 8, "icon": "send", "library": "lucide", "fill": "#FFFFFF"}]}, {"type": "text", "id": "RhzAp", "name": "Meta", "fill": "$t3", "content": "Lark · 2m · 5 行 · 118 字", "fontFamily": "Inter", "fontSize": 12, "fontWeight": "normal"}]}]}, {"type": "frame", "id": "Melk8", "x": 880, "y": 110, "name": "Annotation", "width": 300, "layout": "vertical", "gap": 14, "children": [{"type": "text", "id": "yWauI", "name": "Title", "fill": "$t1", "content": "H · List + Peek", "fontFamily": "Inter", "fontSize": 26, "fontWeight": "700"}, {"type": "text", "id": "Da37e", "name": "State", "fill": "$accent", "textGrowth": "fixed-width", "width": "fill_container", "content": "Light · 悬停 0.5 s → 浮出全文", "fontFamily": "Inter", "fontSize": 15, "fontWeight": "600"}, {"type": "text", "id": "NKVeT", "name": "Note 1", "fill": "$t2", "textGrowth": "fixed-width", "width": "fill_container", "content": "长文字被一行截断时，悬停一会儿在行的右侧浮出一张小卡片，显示完整内容。", "lineHeight": 1.5, "fontFamily": "Inter", "fontSize": 14, "fontWeight": "normal"}, {"type": "text", "id": "j4Rgj", "name": "Note 2", "fill": "$t2", "textGrowth": "fixed-width", "width": "fill_container", "content": "卡片只有内容 + 一行淡灰来源信息，没有按钮。移开鼠标立刻消失。", "lineHeight": 1.5, "fontFamily": "Inter", "fontSize": 14, "fontWeight": "normal"}, {"type": "text", "id": "AKXSx", "name": "Note 3", "fill": "$t2", "textGrowth": "fixed-width", "width": "fill_container", "content": "单击行本身仍然是直接粘贴；预览不改变点击行为。", "lineHeight": 1.5, "fontFamily": "Inter", "fontSize": 14, "fontWeight": "normal"}]}]}, {"type": "frame", "id": "MeRJJ", "x": 2680, "y": 7120, "name": "H3 · Dark · Space peek (image)", "theme": {"mode": "dark"}, "clip": true, "width": 1240, "height": 780, "fill": {"type": "mesh_gradient", "enabled": true, "columns": 3, "rows": 3, "colors": ["$w1", "$w5", "$w2", "$w4", "$w1", "$w6", "$w3", "$w4", "$w2"], "points": [[0, 0], [0.5, 0], [1, 0], [0, 0.5], [0.42, 0.58], [1, 0.5], [0, 1], [0.5, 1], [1, 1]]}, "layout": "none", "children": [{"type": "frame", "id": "SfLAA", "x": 130, "y": 110, "name": "Panel", "clip": true, "width": 400, "fill": "$glass", "cornerRadius": 18, "stroke": "$glass-stroke", "strokeWidth": 1, "strokeAlignment": "inner", "effect": [{"type": "background_blur", "radius": 50}, {"type": "shadow", "shadowType": "outer", "color": "#00000038", "offset": {"x": 0, "y": 16}, "blur": 44}, {"type": "shadow", "shadowType": "outer", "color": "#0000001A", "offset": {"x": 0, "y": 1}, "blur": 3}], "layout": "vertical", "padding": 6, "children": [{"type": "frame", "id": "Jt2Yz", "name": "Row · Lark", "width": "fill_container", "height": 32, "cornerRadius": 9, "gap": 10, "padding": [0, 10], "alignItems": "center", "children": [{"type": "frame", "id": "djf1b", "name": "App lark", "width": 16, "height": 16, "fill": {"type": "gradient", "gradientType": "linear", "enabled": true, "rotation": 180, "size": {"height": 1}, "colors": [{"color": "#3C8CFF", "position": 0}, {"color": "#16C1B3", "position": 1}]}, "cornerRadius": 4, "stroke": "$hair", "strokeWidth": 1, "strokeAlignment": "inner", "justifyContent": "center", "alignItems": "center", "children": [{"type": "icon", "id": "XiBCo", "name": "Glyph", "width": 10, "height": 10, "icon": "send", "library": "lucide", "fill": "#FFFFFF"}]}, {"type": "frame", "id": "XUWCu", "name": "Content", "clip": true, "width": "fill_container", "height": 18, "gap": 7, "a