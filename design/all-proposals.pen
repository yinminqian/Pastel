er", "justifyContent": "center", "alignItems": "center", "children": [{"type": "icon", "id": "QRY9O", "name": "Glyph", "width": 10, "height": 10, "icon": "terminal", "library": "lucide", "fill": "#FFFFFF"}]}, {"type": "frame", "id": "j5Eln", "name": "Content", "clip": true, "width": "fill_container", "height": 18, "gap": 7, "alignItems": "center", "children": [{"type": "text", "id": "o6rNy", "name": "Text", "fill": "$t1", "content": "ssh deploy@10.0.3.21 -p 2222", "fontFamily": "JetBrains Mono", "fontSize": 12.5, "fontWeight": "normal"}]}]}, {"type": "frame", "id": "wLp3l", "name": "Row · PR", "width": "fill_container", "height": 32, "cornerRadius": 9, "gap": 10, "padding": [0, 10], "alignItems": "center", "children": [{"type": "frame", "id": "v8HLGA", "name": "App safari", "width": 16, "height": 16, "fill": {"type": "gradient", "gradientType": "linear", "enabled": true, "rotation": 180, "size": {"height": 1}, "colors": [{"color": "#35B6FF", "position": 0}, {"color": "#0A6CFF", "position": 1}]}, "cornerRadius": 4, "justifyContent": "center", "alignItems": "center", "children": [{"type": "icon", "id": "ANmkZ", "name": "Glyph", "width": 10, "height": 10, "icon": "compass", "library": "lucide", "fill": "#FFFFFF"}]}, {"type": "frame", "id": "Z17EeR", "name": "Content", "clip": true, "width": "fill_container", "height": 18, "alignItems": "center", "children": [{"type": "text", "id": "Ei0PP", "name": "Text", "fill": "$t1", "content": "github.com", "fontFamily": "Inter", "fontSize": 13, "fontWeight": "normal"}, {"type": "text", "id": "Hwe7K", "name": "Text", "fill": "$t3", "content": "/ihealth/paster/pull/482", "fontFamily": "Inter", "fontSize": 13, "fontWeight": "normal"}]}]}]}, {"type": "icon", "id": "x7KZd", "x": 470, "y": 378, "name": "Mouse Pointer", "width": 20, "height": 20, "icon": "cursor-fill", "library": "phosphor", "fill": "#1D1D1F", "effect": {"type": "shadow", "shadowType": "outer", "color": "#FFFFFFCC", "blur": 2, "spread": 1}}, {"type": "frame", "id": "h5355L", "x": 600, "y": 130, "name": "Annotation", "width": 320, "layout": "vertical", "gap": 14, "children": [{"type": "text", "id": "eNAAh", "name": "Title", "fill": "$t1", "content": "E · Plain List", "fontFamily": "Inter", "fontSize": 26, "fontWeight": "700"}, {"type": "text", "id": "eBcMd", "name": "State", "fill": "$accent", "content": "Light · 选中第 1 行，鼠标悬停第 8 行", "fontFamily": "Inter", "fontSize": 15, "fontWeight": "600"}, {"type": "text", "id": "LN0IT", "name": "Note 1", "fill": "$t2", "textGrowth": "fixed-width", "width": "fill_container", "content": "整块面板就是一列内容，没有标题栏、没有搜索框、没有底栏。", "lineHeight": 1.5, "fontFamily": "Inter", "fontSize": 14, "fontWeight": "normal"}, {"type": "text", "id": "NJjFY", "name": "Note 2", "fill": "$t2", "textGrowth": "fixed-width", "width": "fill_container", "content": "每行 = 16 pt 来源 App 图标 + 内容本身一行。图片带真实缩略图，颜色带色块，文件带文件图标。", "lineHeight": 1.5, "fontFamily": "Inter", "fontSize": 14, "fontWeight": "normal"}, {"type": "text", "id": "P8TBVV", "name": "Note 3", "fill": "$t2", "textGrowth": "fixed-width", "width": "fill_container", "content": "时间只在悬停 / 选中行出现，右侧淡灰。其余行右边完全留空。", "lineHeight": 1.5, "fontFamily": "Inter", "fontSize": 14, "fontWeight": "normal"}, {"type": "text", "id": "Fp6qC", "name": "Note 4", "fill": "$t2", "textGrowth": "fixed-width", "width": "fill_container", "content": "选中 = 淡橙色圆角底 + ↩（回车粘贴）；悬停 = 更淡的中性灰底 + 点击图标（单击粘贴）。", "lineHeight": 1.5, "fontFamily": "Inter", "fontSize": 14, "fontWeight": "normal"}, {"type": "text", "id": "O1J2A9", "name": "Note 5", "fill": "$t2", "textGrowth": "fixed-width", "width": "fill_container", "content": "400 × 476 pt，14 行一屏看完。", "lineHeight": 1.5, "fontFamily": "Inter", "fontSize": 14, "fontWeight": "normal"}]}]}, {"type": "frame", "id": "c72q3", "x": 1100, "y": 3530, "name": "E2 · Dark · Selected", "theme": {"mode": "dark"}, "clip": true, "width": 1000, "height": 760, "fill": {"type": "mesh_gradient", "enabled": true, "columns": 3, "rows": 3, "colors": ["$w1", "$w5", "$w2", "$w4", "$w1", "$w6", "