    "A full-height list at the right edge, grouped by day": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贴在右边、占满屏幕高度的列表，按天分组"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右端に画面の高さいっぱいに並ぶ日付別リスト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 가장자리의 전체 높이 목록, 날짜별 그룹"
          }
        }
      }
    },
    "A list beside a preview of the selection": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表加选中内容的预览"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストと選択項目のプレビュー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록과 선택 항목 미리보기"
          }
        }
      }
    },
    "A list that drops from the top, like Spotlight": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像 Spotlight 一样从顶部落下的列表"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight のように上から現れるリスト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight처럼 위에서 내려오는 목록"
          }
        }
      }
    },
    "A one-line list in a small floating panel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小浮窗里的单行列表"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さなフローティングパネルの一行リスト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 플로팅 패널의 한 줄 목록"
          }
        }
      }
    },
    "Access token": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
