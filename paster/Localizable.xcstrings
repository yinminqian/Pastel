{
  "sourceLanguage": "en",
  "strings": {
    "%@ is already taken": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被占用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は既に使われています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이미 사용 중입니다"
          }
        }
      }
    },
    "%@ · copied %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@复制"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@にコピー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ 복사함"
          }
        }
      }
    },
    "%@, %@": {
      "shouldTranslate": false
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld characters": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
