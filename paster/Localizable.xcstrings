    "All Types": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有类型"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての種類"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 유형"
          }
        }
      }
    },
    "Allow accessibility access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许辅助功能权限"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティを許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한 허용"
          }
        }
      }
    },
    "Allow clipboard access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许读取剪贴板"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードへのアクセスを許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 접근 허용"
          }
        }
      }
    },
    "Always ignored": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终忽略"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に無視"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 무시"
          }
        }
      }
    },
    "Another app claimed it first. Pick a different combination above.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 App 已经占用了它。请在上面换一个组合键。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の App が先に使用しています。上で別の組み合わせを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 먼저 사용 중입니다. 위에서 다른 조합을 선택하세요."
          }
        }
      }
    },
    "Another app claimed it first. Pick a different shortcut, or click the Dock icon.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 App 已经占用了它。换一个快捷键，或者点击程序坞图标。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の App が先に使用しています。別のショートカットを選ぶか、Dock のアイコンをクリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 먼저 사용 중입니다. 다른 단축키를 선택하거나 Dock 아이콘을 클릭하세요."
          }
        }
      }
    },
    "Another device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一台设备"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기"
          }
        }
      }
    },
    "Basic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基础风"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベーシック"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본"
          }
        }
      }
    },
    "Both limits apply. Lowering either takes effect on the next copy. Pinned clippings are exempt from both.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个上限同时生效。调低任一项会在下次复制时生效。已置顶的内容不受限制。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の上限が適用されます。どちらかを下げると次のコピー時に反映されます。ピン留めした項目は対象外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 한도가 모두 적용됩니다. 한도를 낮추면 다음 복사 시 적용됩니다. 고정된 항목은 제외됩니다."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "Change Shortcut": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
