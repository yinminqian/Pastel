            "value": "%lld 文字"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld자"
          }
        }
      }
    },
    "%lld clippings will be deleted.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clipping will be deleted."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld clippings will be deleted."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除 %lld 条内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の項目が削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 %lld개가 삭제됩니다."
          }
        }
      }
    },
    "%lld clippings · %lld pinned": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 条剪贴 · %2$lld 条置顶"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 件 · ピン留め %2$lld 件"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립 %1$lld개 · 고정 %2$lld개"
          }
        }
      }
    },
    "%lld pinned clippings are kept.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld pinned clipping is kept."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld pinned clippings are kept."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已置顶的 %lld 条会保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めした %lld 件は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 항목 %lld개는 유지됩니다."
          }
        }
      }
    },
